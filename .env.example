# Copy to `.env` for local runs:
#   cp .env.example .env
#
# These are the public production endpoints. The app also falls back to the
# same hosts in `next.config.ts` and the HTTP/SSE clients if a value is omitted.

# Go backend (agent store, orders, auth, objects)
NEXT_PUBLIC_CROO_API_BASE_URL=https://api.croo.network/backend/v1
BACKEND_URL=https://api.croo.network

# Navigator AI service (conversation + SSE)
NEXT_PUBLIC_CROO_AI_BASE_URL=https://api.croo.network/navigator/v1
AI_SERVICE_URL=https://api.croo.network/navigator/v1

# Public object CDN (avatars, deliveries)
NEXT_PUBLIC_COS_HOST=https://object.croo.network

# WalletConnect Cloud project (public client id)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=750ae11a5990e06f8106eedbc777094c
